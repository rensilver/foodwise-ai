# Copy to .env only if it does not already exist. Never commit .env.
# Backend only: load this file explicitly; it is not frontend configuration.
# Required secrets are intentionally blank and fail validation until supplied.
# No NEXT_PUBLIC_* settings are needed. Never rename these variables with that
# prefix or put them in next.config env: Next.js would publish those values.
# Do not pass backend settings to the frontend process, including unprefixed
# names: server rendering can expose them in HTML. The Next.js guard rejects them.

# Required: supply a fresh Groq key. Model access is checked separately, opt-in.
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
GROQ_VISION_MODEL=qwen/qwen3.8-27b

# Optional: blank means live trends are unavailable.
TAVILY_API_KEY=

# Host-process examples. Database/MCP have no published Compose ports by default.
# Add your local DB password if required; URL-encode reserved characters.
# Compose supplies its own internal URLs and mounted MEDIA_ROOT, ignoring these
# three host-process values. Do not point host processes at unpublished ports.
DATABASE_URL=postgresql+psycopg://foodwise@127.0.0.1:5432/foodwise
MCP_SERVER_URL=http://127.0.0.1:8001/mcp
# Change to your absolute media directory/mount. Validation creates no directory.
MEDIA_ROOT=/tmp/foodwise-ai/media

# Required: Argon2id v19 PHC hash, never plaintext. Use single quotes around the
# supplied hash so its dollar signs stay literal in dotenv/shell contexts.
# Accepted costs: m=19456..262144 KiB, t=2..10, p=1..16;
# salt 16..64 bytes, digest 32..64 bytes. See backend/README.md.
ADMIN_PASSWORD_HASH=

# Compose only: two distinct local database passwords, deliberately blank.
# Generate each independently, e.g. with `openssl rand -hex 32`.
# FOODWISE_DB_PASSWORD must use only letters, digits, _ or - because Compose
# embeds it into the internal connection URL. The bootstrap rejects other chars.
# POSTGRES_PASSWORD is for initialization/maintenance; services use the limited
# foodwise role and FOODWISE_DB_PASSWORD. Initialization runs on a fresh volume
# only; changing these values does not rotate an existing database password.
POSTGRES_PASSWORD=
FOODWISE_DB_PASSWORD=
